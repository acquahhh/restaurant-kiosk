{
  "name": "restaurant-kiosk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"lib/**/*.test.ts\"",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "serve": "next start -H 0.0.0.0 -p 3000",
    "serve:https": "node scripts/https-server.mjs",
    "certs": "node scripts/make-certificates.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
