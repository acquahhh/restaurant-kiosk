# Country of this restaurant: GH (Ghana), RW (Rwanda) or KE (Kenya).
# Sets currency, phone format, time zone and payment options. Must match the
# database (restaurant_settings.country); see docs/SETUP-SUPABASE.md, "Country".
NEXT_PUBLIC_COUNTRY=GH

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by server actions to write orders.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — from Settings → API Keys & Webhooks (use test keys until go-live)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Paystack needs an email per charge; kiosk receipts go to the restaurant's inbox.
PAYSTACK_ORDER_EMAIL=orders@your-restaurant.com

# Optional: a PUBLIC https page Paystack sends the customer's phone to after a
# card payment. Leave unset for a restaurant-only server: Paystack then shows
# its own confirmation (a phone on mobile data cannot open a local address).
# PAYSTACK_CALLBACK_URL=
