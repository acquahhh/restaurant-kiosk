# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by server actions to write orders.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — from Settings → API Keys & Webhooks (use test keys until go-live)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Paystack needs an email per charge; kiosk receipts go to the restaurant's inbox.
PAYSTACK_ORDER_EMAIL=orders@your-restaurant.com

# Public URL of this deployment (used for Paystack callback and webhook URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
